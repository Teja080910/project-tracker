# ============================================================
# Supabase (required)
# Get these from Supabase Dashboard > Project Settings > API
# ============================================================

# URL of your Supabase project (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL        = "http://127.0.0.1:54321"

# Public anon key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY   = "your-anon-key"

# Service role key (server-side only — NEVER expose in the browser)
SUPABASE_SERVICE_ROLE_KEY       = "your-service-role-key"

# ============================================================
# App branding (optional — falls back to "Trackflow")
# ============================================================

# Company / app name shown in the UI and page title
NEXT_PUBLIC_APP_NAME            = "Art of Living"

# Public URL of the deployed app (used for metadata / canonical links)
NEXT_PUBLIC_APP_URL             = "http://localhost:3000"

# Company logo image URL (shown on login, signup, sidebar, topbar)
NEXT_PUBLIC_APP_LOGO_URL        = "https://www.artofliving.org/sites/all/themes/artofliving/images/logo.png"
