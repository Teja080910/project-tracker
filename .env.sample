# ============================================================
# Platform API (required)
# ============================================================

# NestJS platform API
NEXT_PUBLIC_API_URL             = "http://127.0.0.1:4105"

# Platform auth service
NEXT_PUBLIC_AUTH_URL            = "http://127.0.0.1:4100"

# Platform realtime WebSocket gateway
NEXT_PUBLIC_WS_URL              = "ws://127.0.0.1:4105/ws"

# Public base URL for uploaded files
NEXT_PUBLIC_FILES_URL           = "http://127.0.0.1:19000/pt-task-screenshots"

# ============================================================
# App branding (optional — falls back to "Trackflow")
# ============================================================

# Company / app name shown in the UI and page title
NEXT_PUBLIC_APP_NAME            = "Art of Living"

# Public URL of the deployed app (used for metadata / canonical links)
NEXT_PUBLIC_APP_URL             = "http://localhost:3000"

# Company logo image URL (shown on login, signup, sidebar, topbar)
NEXT_PUBLIC_APP_LOGO_URL        = "/logo.svg"

# ============================================================
# SMTP (Gmail) — for auth emails + notification emails
# Use a Gmail App Password (Google > Security > 2-Step Verification > App passwords)
# ============================================================

SMTP_HOST                      = "smtp.gmail.com"
SMTP_PORT                      = "587"
SMTP_USER                      = "your-gmail@gmail.com"
SMTP_PASS                      = "your-app-password"
SMTP_FROM                      = "your-gmail@gmail.com"
SMTP_SENDER_NAME               = "Art of Living"

# ============================================================
# Web Push (browser push notifications)
# Generate keys with: npx web-push generate-vapid-keys
# ============================================================

NEXT_PUBLIC_VAPID_PUBLIC_KEY    = "your-vapid-public-key"
VAPID_PRIVATE_KEY               = "your-vapid-private-key"
VAPID_SUBJECT                   = "mailto:you@gmail.com"
