# ============================================================
# Supabase (required)
# Get these from Supabase Dashboard > Project Settings > API
# ============================================================

# URL of your Supabase project (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL        = "http://127.0.0.1:54321"

# Public anon key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY   = "your-anon-key"

# Service role key (server-side only — NEVER expose in the browser)
SUPABASE_SERVICE_ROLE_KEY       = "your-service-role-key"

# ============================================================
# App branding (optional — falls back to "Trackflow")
# ============================================================

# Company / app name shown in the UI and page title
NEXT_PUBLIC_APP_NAME            = "Art of Living"

# Public URL of the deployed app (used for metadata / canonical links)
NEXT_PUBLIC_APP_URL             = "http://localhost:3000"

# Company logo image URL (shown on login, signup, sidebar, topbar)
NEXT_PUBLIC_APP_LOGO_URL        = "https://upload.wikimedia.org/wikipedia/en/0/0b/Art_of_Living_official_logo.png"

# ============================================================
# SMTP (Gmail) — for auth emails + notification emails
# Use a Gmail App Password (Google > Security > 2-Step Verification > App passwords)
# ============================================================

SMTP_HOST                      = "smtp.gmail.com"
SMTP_PORT                      = "587"
SMTP_USER                      = "your-gmail@gmail.com"
SMTP_PASS                      = "your-app-password"
SMTP_FROM                      = "your-gmail@gmail.com"
SMTP_SENDER_NAME               = "Art of Living"
